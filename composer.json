{
	"name": "phpbb/topicprefixes",
	"type": "phpbb-extension",
	"description": "An official phpBB extension for administrator-curated topic tags.",
	"homepage": "https://www.phpbb.com/customise/db/extension/topicprefixes/",
	"version": "2.0.0",
	"license": "GPL-2.0-only",
	"authors": [
		{
			"name": "Matt Friedman",
			"homepage": "https://imattpro.github.io",
			"role": "Extensions Development Team Lead"
		},
		{
			"name": "Ruslan Uzdenov",
			"homepage": "https://www.phpbbguru.net",
			"role": "Extensions Development Team"
		}
	],
	"require": {
		"php": ">=7.2",
		"composer/installers": "^1.0 || ^2.0"
	},
	"require-dev": {
		"phing/phing": "~2.4"
	},
	"extra": {
		"display-name": "phpBB Topic Prefixes",
		"soft-require": {
			"phpbb/phpbb": ">=3.3.18"
		},
		"version-check": {
			"host": "www.phpbb.com",
			"directory": "/customise/db/extension/topicprefixes",
			"filename": "version_check",
			"ssl": true
		}
	}
}
